# Kunu Media Downloader — Environment Variables Example
# Copy this file to .env for local development or configure in your hosting dashboard (Vercel / Render / Railway).

# Server Port (defaults to 3000)
PORT=3000

# Node Environment (development | production)
NODE_ENV=development

# Maximum allowed file size in bytes for backend proxy stream (default: 150MB = 157286400)
MAX_DOWNLOAD_BYTES=157286400

# Request timeout in milliseconds for upstream media inspection/streaming (default: 15000)
UPSTREAM_TIMEOUT_MS=15000

# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum API requests per IP per window (default: 30)
RATE_LIMIT_MAX_REQUESTS=30
